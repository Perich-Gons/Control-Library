{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenRich Knowledge Resolution",
  "type": "object",
  "required": [
    "title",
    "status",
    "created_at",
    "question",
    "conclusion",
    "sources",
    "limitations"
  ],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 140
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "verified",
        "superseded",
        "rejected"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "question": {
      "type": "string",
      "maxLength": 4000
    },
    "conclusion": {
      "type": "string",
      "maxLength": 12000
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,40}$"
      }
    },
    "capability_fingerprint": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9._-]{1,80}$"
      }
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimum_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["checks", "expected", "rollback"],
      "properties": {
        "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 500}},
        "expected": {"type": "string", "maxLength": 1000},
        "rollback": {"type": "string", "maxLength": 1000}
      },
      "additionalProperties": false
    },
    "source_kind": {
      "enum": [
        "local",
        "external_research",
        "community"
      ]
    }
  },
  "additionalProperties": false
}
